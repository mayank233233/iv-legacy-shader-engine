; GMA Edition experiments — all disabled by default.
; Binding-cache experiment is implemented but remains opt-in and unvalidated
; on real GTA IV hardware. Keep it off unless testing this branch.
[General]
EnableBindingCache=0
StateCacheReportFrames=120

; Reserved render-path experiments; not yet runtime implemented.
[GMAEdition]
LowResEnabled=0
LowResWidth=320
LowResHeight=240
FixedFunctionProbe=0
ProbeDrawCount=10
